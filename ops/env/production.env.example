# =============================================================================
# Chatwoot (fork Automato, edição CE) — variáveis de ambiente de PRODUÇÃO
# =============================================================================
# Template SEM segredos. Os valores reais vão SOMENTE nas variáveis de
# ambiente dos serviços no Easypanel (projeto "sites", serviços "chatwoot-rails" e
# "chatwoot-sidekiq" recebem exatamente o mesmo conjunto).
#
# ⚠️  Este repositório é PÚBLICO. Nunca commite um .env preenchido.
#
# Gere os segredos com:  ops/scripts/generate-secrets.sh
# Referência completa do upstream: .env.example (raiz do repo) e
# https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables
# Blueprint do deploy: docs/fork/deploy-easypanel.md
# =============================================================================

# -----------------------------------------------------------------------------
# Núcleo
# -----------------------------------------------------------------------------
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
# URL pública (sem barra no final). Também compõe as URLs de webhook do WhatsApp.
FRONTEND_URL=https://crm.automato.pro
FORCE_SSL=true
# Só o Super Admin cria contas; ninguém se cadastra sozinho pela tela de login.
ENABLE_ACCOUNT_SIGNUP=false
# Idioma padrão das telas públicas e das contas novas.
DEFAULT_LOCALE=pt_BR

# Edição Community. A imagem CE já vem sem a pasta enterprise/ (ver
# .github/workflows/fork-ce-image.yml); as duas linhas abaixo são redundância.
DISABLE_ENTERPRISE=true
CW_EDITION=ce

# -----------------------------------------------------------------------------
# Segredos (gerar com ops/scripts/generate-secrets.sh)
# -----------------------------------------------------------------------------
SECRET_KEY_BASE=
# Necessárias para MFA/2FA. NUNCA mude depois que o banco estiver em uso.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# -----------------------------------------------------------------------------
# Postgres dedicado (imagem pgvector/pgvector:pg16 — a extensão "vector" é
# obrigatória) e Redis dedicado. Hostnames = rede interna do Easypanel
# (<projeto>_<serviço>; o Chatwoot roda no projeto "sites"). NÃO exponha portas.
# -----------------------------------------------------------------------------
POSTGRES_HOST=sites_chatwoot-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
# Tempo máximo de uma query (padrão 14s). Só mude se houver motivo.
# POSTGRES_STATEMENT_TIMEOUT=14s

REDIS_URL=redis://sites_chatwoot-redis:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Dimensionamento (VPS atual: 2 vCPU / 8 GB compartilhada com outros sistemas)
# Concorrência web ~= WEB_CONCURRENCY x RAILS_MAX_THREADS.
# Ao migrar para uma VPS maior: WEB_CONCURRENCY = nº de vCPUs, SIDEKIQ_CONCURRENCY=10.
# -----------------------------------------------------------------------------
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5

# -----------------------------------------------------------------------------
# E-mail de saída — Amazon SES (sa-east-1) via SMTP
# O domínio msg.automato.pro já está verificado no SES. Use uma credencial
# SMTP EXCLUSIVA do Chatwoot (SES > SMTP settings > Create SMTP credentials,
# ou usuário IAM com permissão apenas ses:SendRawEmail). Usuário/senha SMTP
# NÃO são a Access Key/Secret do IAM.
# -----------------------------------------------------------------------------
MAILER_SENDER_EMAIL=Automato <no-reply@msg.automato.pro>
SMTP_DOMAIN=msg.automato.pro
SMTP_ADDRESS=email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# -----------------------------------------------------------------------------
# Anexos (mídias do WhatsApp, avatares) — AWS S3, bucket e usuário IAM
# EXCLUSIVOS do Chatwoot. Política mínima em docs/fork/deploy-easypanel.md.
# -----------------------------------------------------------------------------
ACTIVE_STORAGE_SERVICE=amazon
S3_BUCKET_NAME=
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Upload direto do navegador para o S3 (exige CORS no bucket). Deixe vazio no início.
DIRECT_UPLOADS_ENABLED=
# Endurece o processamento de imagens enviadas por terceiros.
VIPS_BLOCK_UNTRUSTED=1

# -----------------------------------------------------------------------------
# Logs e proteção
# -----------------------------------------------------------------------------
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ENABLE_RACK_ATTACK=true
# Notificações push dos apps oficiais (iOS/Android) via relay da Chatwoot Inc.
# ⚠️ LGPD: com o relay ligado, o conteúdo das notificações (ex.: prévia da
# mensagem do cliente) passa pelos servidores da Chatwoot Inc. Sem ele, os
# apps móveis oficiais não recebem push. Desligue (false) se a operação não
# usar os apps móveis ou se a política de dados não permitir.
ENABLE_PUSH_RELAY_SERVER=true

# Telemetria: por padrão a instância envia diariamente à Chatwoot Inc. contagens
# de contas/usuários/caixas/conversas/mensagens e eventos de uso. Com
# DISABLE_TELEMETRY=true só segue o ping de versão (host, versão e edição),
# usado para avisar de atualizações.
DISABLE_TELEMETRY=true

# -----------------------------------------------------------------------------
# WhatsApp (API oficial — Cloud API da Meta)
# -----------------------------------------------------------------------------
# NÃO há variáveis de ambiente para o WhatsApp. Tudo é configurado no app:
#   - Setup manual: na criação da inbox (WABA ID, Phone Number ID, token).
#   - Embedded Signup: Super Admin > Integrations > WhatsApp Embedded (WHATSAPP_APP_ID,
#     WHATSAPP_CONFIGURATION_ID, WHATSAPP_APP_SECRET) + feature flag na conta.
# Passo a passo: docs/fork/whatsapp.md

# -----------------------------------------------------------------------------
# FUTURO — canais documentados, ainda NÃO habilitados (docs/fork/canais-futuros.md)
# -----------------------------------------------------------------------------
# Instagram / Facebook Messenger (exige App Meta PRÓPRIO do Chatwoot + App Review)
# FB_APP_ID=
# FB_APP_SECRET=
# FB_VERIFY_TOKEN=
# IG_VERIFY_TOKEN=
#
# Caixa de entrada por e-mail (respostas de clientes voltando para o Chatwoot)
# MAILER_INBOUND_EMAIL_DOMAIN=
# RAILS_INBOUND_EMAIL_SERVICE=
# RAILS_INBOUND_EMAIL_PASSWORD=
# ACTION_MAILBOX_SES_SNS_TOPIC=
